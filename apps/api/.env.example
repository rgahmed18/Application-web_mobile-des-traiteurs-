# ── Application ──
NODE_ENV=development
PORT=3000
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:3001,http://localhost:8081
SWAGGER_ENABLED=true
# Adresse publique du site web : liens des devis envoyés aux clients (/devis/…)
PUBLIC_WEB_URL=http://localhost:3001
# IP réelle du client derrière un reverse proxy (limitation de débit, quotas SMS, journaux).
#   false        : pas de proxy, X-Forwarded-For est ignoré (défaut, à garder sans proxy)
#   true ou 1    : un proxy de confiance (nginx, load balancer)
#   2, 3...      : nombre de proxys de confiance (ex. CDN + load balancer = 2)
#   liste        : adresses ou sous-réseaux des proxys, ex. loopback,10.0.0.0/8
# Le back-office (routes /api/session de Next) transmet l'IP du navigateur : la liste doit
# inclure le serveur Next (« loopback » en développement). Tableau des valeurs de production
# dans le README, section « IP réelle des clients ».
TRUST_PROXY=loopback

# ── Base de données (docker compose expose PostgreSQL sur le port 5433) ──
DATABASE_URL=postgresql://traiteur:traiteur@localhost:5433/gestion_traiteurs?schema=public
# Base dédiée aux tests d'intégration (créée par docker/postgres/init.sql)
TEST_DATABASE_URL=postgresql://traiteur:traiteur@localhost:5433/gestion_traiteurs_test?schema=public

# ── Redis (cache des permissions + files BullMQ) ──
REDIS_URL=redis://localhost:6379

# ── Authentification ──
# Secrets : 32 caractères minimum. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-with-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ── Double authentification (TOTP) : clé de chiffrement des secrets ──
TWO_FACTOR_ENCRYPTION_KEY=change-me-with-a-third-long-random-secret-32-chars

# ── Codes SMS (OTP) ──
OTP_SECRET=change-me-with-another-long-random-secret-32-chars-min
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
# Demandes de code par adresse IP sur 24 h glissantes, tous numéros confondus
OTP_MAX_PER_IP_PER_DAY=20

# ── SMS (protection contre le « SMS pumping ») ──
# Fournisseur : console (SMS simulé, le code s'affiche dans les logs ; interdit en production),
# http (agrégateur marocain, voir SMS_HTTP_*) ou twilio. Le secours est essayé si le principal
# échoue (panne, refus, délai dépassé) : en production, http + twilio en secours.
SMS_PROVIDER=console
SMS_FALLBACK_PROVIDER=none
SMS_TIMEOUT_MS=10000
# Nom d'expéditeur (11 caractères au plus), à faire valider par le fournisseur
# SMS_SENDER=DarDiafa
# Agrégateur HTTP : gabarits {{to}}, {{message}}, {{sender}} (encodés automatiquement).
#   Exemple GET  : SMS_HTTP_URL=https://api.fournisseur.ma/send?key=CLE&to={{to}}&text={{message}}&from={{sender}}
#   Exemple POST : SMS_HTTP_METHOD=POST  SMS_HTTP_CONTENT_TYPE=json
#                  SMS_HTTP_BODY={"to":"{{to}}","message":"{{message}}","sender":"{{sender}}"}
#                  SMS_HTTP_AUTH_HEADER=Bearer CLE
# SMS_HTTP_URL=
# SMS_HTTP_METHOD=POST
# SMS_HTTP_BODY=
# SMS_HTTP_CONTENT_TYPE=json
# SMS_HTTP_AUTH_HEADER=
# Format du numéro attendu : e164 (+212…), international (212…), national (06…)
# SMS_HTTP_PHONE_FORMAT=international
# Motif que la réponse doit contenir pour être un succès (selon la documentation du fournisseur)
# SMS_HTTP_SUCCESS_PATTERN=
# Twilio (console.twilio.com) : SID du compte (AC…), jeton, expéditeur ou service (MG…)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=
# Plafond global de SMS envoyés sur 24 h glissantes, toutes demandes confondues
SMS_DAILY_GLOBAL_LIMIT=2000
# Indicatifs pays autorisés à recevoir un SMS, sans « + », séparés par des virgules.
# Les autres numéros restent acceptés pour un compte, mais aucun SMS ne leur est envoyé.
SMS_ALLOWED_COUNTRY_CODES=212

# ── Suivi des erreurs (Sentry) : laisser vide pour le désactiver ──
# Aucune donnée personnelle ni secret envoyé (collecte du SDK désactivée + filtrage).
# SENTRY_DSN=https://<clé>@<org>.ingest.sentry.io/<projet>
# SENTRY_ENVIRONMENT=staging
# SENTRY_RELEASE=  (renseigné automatiquement par le déploiement : version de l'image)
SENTRY_TRACES_SAMPLE_RATE=0

# Rendu des PDF (Typst) : nombre de threads et délai maximal par document (ms)
PDF_WORKERS=2
PDF_RENDER_TIMEOUT_MS=20000

# ── Connexion par mot de passe (protection contre la force brute) ──
# Échecs consécutifs avant le premier verrouillage du compte
LOGIN_MAX_FAILURES=5
# Durées de verrouillage progressives en minutes ; la dernière s'applique ensuite
LOGIN_LOCKOUT_MINUTES=1,5,15,60,240,1440

# ── Stockage (S3) ──
# Deux buckets : S3_BUCKET (photos traitées, public) et S3_DOCUMENTS_BUCKET (factures, reçus,
# devis, photos de chèques, envois bruts : privé, URL signées uniquement). Ils doivent différer.
# Développement : RustFS lancé par docker compose. Production : Cloudflare R2
#   S3_ENDPOINT=https://<compte>.r2.cloudflarestorage.com  S3_REGION=auto  S3_FORCE_PATH_STYLE=false
#   S3_PUBLIC_URL=https://media.<votre-domaine> (domaine public du SEUL bucket des photos)
#   S3_AUTO_SETUP=false (buckets et CORS configurés dans le tableau de bord Cloudflare)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=traiteur-media
S3_DOCUMENTS_BUCKET=traiteur-documents
S3_ACCESS_KEY_ID=traiteur
S3_SECRET_ACCESS_KEY=traiteur-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/traiteur-media
# Crée les deux buckets, la lecture publique des photos traitées et le CORS au démarrage (dev / CI)
S3_AUTO_SETUP=true
