# ── Application ──
NODE_ENV=development
PORT=3000
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:3001,http://localhost:8081
SWAGGER_ENABLED=true

# ── Base de données (docker compose expose PostgreSQL sur le port 5433) ──
DATABASE_URL=postgresql://traiteur:traiteur@localhost:5433/gestion_traiteurs?schema=public

# ── Redis (cache des permissions + files BullMQ) ──
REDIS_URL=redis://localhost:6379

# ── Authentification ──
# Secret de signature des access tokens : 32 caractères minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-with-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
