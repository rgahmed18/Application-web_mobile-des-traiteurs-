# ── Navigateur (publiques : lues au démarrage du serveur et publiées dans la page) ──
# URL de l'API appelée directement par le back-office (données du catalogue...). En production :
# « /api/v1 » (chaque adresse, console ou traiteur, appelle l'API sur elle-même derrière Caddy)
PUBLIC_API_URL=http://localhost:3000/api/v1
# Base publique des photos (RustFS en développement, Cloudflare R2 / CDN en production)
PUBLIC_MEDIA_URL=http://localhost:9000/traiteur-media

# Suivi des erreurs du navigateur (Sentry) : vide = désactivé. Le DSN est public par nature.
# PUBLIC_SENTRY_DSN=
# PUBLIC_SENTRY_ENVIRONMENT=staging

# ── Serveur Next uniquement (routes /api/session) ──
# URL de l'API vue depuis le serveur Next (réseau interne en production)
API_INTERNAL_URL=http://localhost:3000/api/v1
# Le traiteur vient de l'adresse (résolue par l'API) : console sur http://localhost:3001,
# back-office de Dar Diafa sur http://dar-diafa.localhost:3001.
# Démonstration seulement : « ?traiteur=<identifiant> » et liste de choix sur la console.
# Désactivé par défaut, refusé au démarrage si NODE_ENV=production (donc avec « next start »).
DEMO_SPACE_SELECTION=false
# Proxys de confiance devant Next, pour transmettre à l'API l'IP réelle du navigateur
# (limitation de débit, quotas SMS, journal d'audit). Voir « IP réelle des clients » du README.
#   0 : aucun proxy (développement) — X-Forwarded-For du navigateur ignoré, aucune IP transmise
#   1 : Nginx (ou Cloudflare + Nginx avec le module real_ip)   2 : Cloudflare puis Nginx sans real_ip
WEB_TRUSTED_PROXY_HOPS=0
# Durée du cookie de session, alignée sur REFRESH_TOKEN_TTL_DAYS de l'API
REFRESH_COOKIE_MAX_AGE_DAYS=30
# Cookie « Secure » : laisser à true (Chrome, Edge et Firefox l'acceptent sur http://localhost).
# Ne passer à false que pour un navigateur qui le refuse en local (Safari).
REFRESH_COOKIE_SECURE=true

# Suivi des erreurs du serveur Next (Sentry) : vide = désactivé
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging
