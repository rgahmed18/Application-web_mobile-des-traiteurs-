# Variables lues par docker-compose.yml (toutes facultatives, valeurs par défaut ci-dessous).
# Chaque application a son propre .env.example dans son dossier (apps/*/.env.example).
POSTGRES_USER=traiteur
POSTGRES_PASSWORD=traiteur
POSTGRES_DB=gestion_traiteurs
POSTGRES_PORT=5433
REDIS_PORT=6379
# Stockage des photos (RustFS) : API S3 sur le port 9000, console sur http://localhost:9001
S3_ACCESS_KEY=traiteur
S3_SECRET_KEY=traiteur-secret
S3_PORT=9000
S3_CONSOLE_PORT=9001
