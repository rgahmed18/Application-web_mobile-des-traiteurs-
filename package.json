{
  "name": "gestion-traiteurs",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^22.23.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@traiteur/api",
    "dev:web": "turbo run dev --filter=@traiteur/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "pnpm --filter @traiteur/api db:generate",
    "db:migrate": "pnpm --filter @traiteur/api db:migrate",
    "db:seed": "pnpm --filter @traiteur/api db:seed",
    "db:reset": "pnpm --filter @traiteur/api db:reset"
  },
  "devDependencies": {
    "@traiteur/config": "workspace:*",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  }
}
