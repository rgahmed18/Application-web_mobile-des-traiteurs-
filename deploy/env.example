# ════════════════════════════════════════════════════════════════════════════════════════
# Configuration d'UN serveur (staging OU production) — copie : /opt/traiteur/.env
#   chmod 600 /opt/traiteur/.env   (lisible par l'utilisateur deploy uniquement)
# JAMAIS dans le dépôt Git. Staging et production ont des valeurs DIFFÉRENTES pour chaque
# secret : un secret de staging ne doit jamais ouvrir la production.
# Générez chaque secret sur le serveur avec la commande indiquée, puis collez la valeur.
# ════════════════════════════════════════════════════════════════════════════════════════

# ── Environnement et adresses ──
# staging ou production
ENVIRONMENT=staging
# Back-office : staging.<domaine> en staging, app.<domaine> en production
APP_HOST=staging.exemple.ma
# Photos (domaine public du bucket media dans Cloudflare R2)
MEDIA_HOST=media-staging.exemple.ma
# Adresse e-mail pour Let's Encrypt (avis d'expiration des certificats)
ACME_EMAIL=vous@exemple.ma
# Staging : « noindex, nofollow » (jamais indexé) ; production : all
ROBOTS=noindex, nofollow

# ── Images Docker (GitHub Container Registry) ──
# ghcr.io/<votre-compte-github en minuscules>
IMAGE_REGISTRY=ghcr.io/votre-compte
# (IMAGE_TAG est écrit par deploy.sh dans .image.env, ne pas le mettre ici)

# ── Traiteur servi par ce back-office ──
# Staging : dar-diafa (démonstration) ; production : slug du traiteur pilote (create-traiteur)
TRAITEUR_SLUG=dar-diafa
# Seed de démonstration : true en STAGING uniquement, JAMAIS en production
ALLOW_DEMO_SEED=true

# ── Base de données et Redis (internes au serveur, jamais exposés) ──
# openssl rand -hex 32
POSTGRES_PASSWORD=
# openssl rand -hex 32
REDIS_PASSWORD=

# ── Secrets de l'API ──
# openssl rand -base64 48
JWT_ACCESS_SECRET=
# openssl rand -base64 48
OTP_SECRET=

# ── Stockage Cloudflare R2 (photos et documents) ──
# Tableau de bord Cloudflare › R2 › « Account ID » : https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Photos : domaine public (MEDIA_HOST). Documents : AUCUN accès public.
S3_MEDIA_BUCKET=traiteur-staging-media
S3_DOCUMENTS_BUCKET=traiteur-staging-documents
# Jeton R2 « Object Read & Write » limité aux DEUX buckets ci-dessus
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Sauvegardes (bucket R2 séparé, jeton séparé) ──
BACKUP_S3_BUCKET=traiteur-staging-backups
# Jeton R2 « Object Read & Write » limité au SEUL bucket des sauvegardes
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Clés publiques age (chiffrement), séparées par une espace :
#   1. clé de SECOURS : générée sur VOTRE ordinateur, privée conservée hors serveur (gestionnaire
#      de mots de passe + copie papier) — voir docs/deploiement.md
#   2. clé MACHINE : générée sur ce serveur (vérification automatique des sauvegardes)
BACKUP_AGE_RECIPIENTS=age1secours... age1machine...
# Clé privée machine (créée par : age-keygen -o /opt/traiteur/secrets/backup-machine.key)
BACKUP_AGE_MACHINE_KEY=/opt/traiteur/secrets/backup-machine.key
# Surveillance des tâches (healthchecks.io) : alerte si la sauvegarde ou sa vérification ne
# s'exécute pas ou échoue. URL de « ping » de chaque contrôle (vide : pas de signalement).
HEALTHCHECK_BACKUP_URL=
HEALTHCHECK_VERIFY_URL=

# ── SMS (staging : console possible ; production : http + twilio en secours) ──
SMS_PROVIDER=console
SMS_FALLBACK_PROVIDER=none
SMS_SENDER=
# Agrégateur local (voir apps/api/.env.example pour la syntaxe des gabarits)
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_BODY=
SMS_HTTP_CONTENT_TYPE=json
SMS_HTTP_AUTH_HEADER=
SMS_HTTP_PHONE_FORMAT=international
SMS_HTTP_SUCCESS_PATTERN=
# Twilio (secours)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ── Suivi des erreurs (Sentry) : DSN du projet ; vide = désactivé ──
SENTRY_DSN=

# ── Ressources (staging CX23, 4 Go : valeurs réduites ; production CX33, 8 Go : défauts) ──
API_MEMORY=1024m
WORKER_MEMORY=512m
WEB_MEMORY=512m
POSTGRES_MEMORY=1g
REDIS_MEMORY=256m
PDF_WORKERS=1
