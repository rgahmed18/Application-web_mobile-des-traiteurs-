# Reverse proxy et HTTPS automatique (Let's Encrypt). APP_HOST : console de la plateforme
# (app.<domaine> en production, staging.<domaine> en staging). Chaque traiteur est servi sur
# <identifiant>.TENANT_BASE_DOMAIN, ou sur son domaine personnalisé vérifié (offre Premium).
# Les photos sont servies directement par Cloudflare R2 (media.<domaine>), pas par ce serveur.
{
	email {$ACME_EMAIL}
	# Certificats des traiteurs demandés à la première visite, SEULEMENT si l'API confirme que
	# l'adresse sert un espace (traiteur existant, ou domaine personnalisé vérifié et actif) :
	# une adresse inconnue n'obtient jamais de certificat (« Espace introuvable »).
	on_demand_tls {
		ask http://api:3000/api/v1/public/spaces/tls-check
	}
	# Pas de journal d'accès : il contiendrait les IP et les URL (dont les jetons des liens de
	# devis et d'invitation). Les erreurs de Caddy restent dans le journal du conteneur.
}

(application) {
	encode zstd gzip

	request_body {
		max_size 25MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Staging : jamais indexé par les moteurs de recherche (ROBOTS=noindex dans son .env)
		X-Robots-Tag "{$ROBOTS:all}"
		-Server
	}

	# Routes de session du back-office (Next), avant l'API
	handle /api/session/* {
		reverse_proxy web:3001
	}

	# API : Caddy transmet l'IP réelle du navigateur (X-Forwarded-For) et l'en-tête Host
	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:3001
	}
}

# Console de la plateforme : certificat obtenu au démarrage
{$APP_HOST} {
	import application
}

# Traiteurs (sous-domaines et domaines personnalisés) : certificat à la demande, après « ask »
https:// {
	tls {
		on_demand
	}
	import application
}
