{
  "name": "@traiteur/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Types, enums et schémas Zod partagés entre l'API, le web et le mobile",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@traiteur/config": "workspace:*",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
